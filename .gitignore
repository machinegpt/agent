# ==============================================================================
# JINX Project Git Ignore Configurations
# ==============================================================================

# --- Python Cache & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
*.bak/

# --- Build & Distribution (setuptools) ---
node_modules/
coverage/
build/
dist/
*.egg-info/
.eggs/

# --- Environment Configuration & Secrets ---
.env
.env.local
.env.*.local

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- CodeGraph local index ---
.codegraph/

# --- OS System Files ---
.DS_Store
Thumbs.db

# --- Test Caches & Diagnostic Reports ---
.pytest_cache/
*.log

# --- JINX Runtime State ---
# Per-run IPC files and the run manifest are session state, not source.
.agent/JINX.yaml
.agent/jinx_request.yaml
.agent/jinx_response.yaml
.agent/jinx_run_state.yaml
# Verdicts of the self-patch preflight waiting for the next prompt (removed as they are read). With
# JINX_SESSIONS=0 they are here; with sessions they sit in the session's own folder under .agent/ipc/.
.agent/notices/
# The rounds of a finished run collected into one .mbox and .yaml (jinx.py --export): a copy, never source.
.agent/export/
# Per-session subtree (JINX_SESSION). Claims, bus notes and per-session manifest,
# baseline and IPC live here; deleting it forgets every session at once.
.agent/ipc/
# Durable cross-run lesson ledger: accumulated knowledge, regenerated as the
# agent learns. Delete it to reset what JINX believes it has learned.
.agent/lessons.yaml
# Self-patch baseline: a throwaway copy of framework source used to roll back a
# failed self-edit. Never source of truth.
.agent/.selfpatch_baseline/
# Lock files of the cross-process locks (lesson ledger, self-patch baseline).
.agent/*.lock
